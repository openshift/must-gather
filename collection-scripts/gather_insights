#!/bin/bash
# Gather the insights archive data from insights operator

BASE_COLLECTION_PATH="${BASE_COLLECTION_PATH:-/must-gather}"
INSIGHTS_DATA_PATH="${BASE_COLLECTION_PATH}/insights-data"

mkdir -p "${INSIGHTS_DATA_PATH}"/

# Default must-gather used oc rsync; rsync can fail (e.g. exit 23) while oc cp works.
# Limit to the deployment pod (not gather Jobs) and quote the pod name.
INSIGHTS_OPERATOR_POD=$(
	oc get pods --namespace=openshift-insights \
		-l app=insights-operator \
		-o custom-columns=:metadata.name --no-headers \
		--field-selector=status.phase=Running | head -n 1
)

if [[ -z "${INSIGHTS_OPERATOR_POD}" ]]; then
	echo "WARNING: No running insights-operator pod; skipping insights archive collection"
	exit 0
fi

echo "INFO: Collecting Insights Archives from ${INSIGHTS_OPERATOR_POD}"
oc cp --namespace=openshift-insights \
	"${INSIGHTS_OPERATOR_POD}:/var/lib/insights-operator" "${INSIGHTS_DATA_PATH}"

#TODO: Prune or Limit the data that is collected/synced (as this might be a lot to add to the archive).

sync
