#!/bin/bash

SCRIPT_DIR=$(cd -- "$(dirname -- "$0")" && pwd -P)

# shellcheck source=collection-scripts/common.sh
source "${SCRIPT_DIR}/common.sh"
# shellcheck source=collection-scripts/status_reporting.sh
source "${SCRIPT_DIR}/status_reporting.sh"
# shellcheck source=collection-scripts/version
source "${SCRIPT_DIR}/version"

mapfile -t collectors < <(sed '/^\s*#/d; /^\s*$/d' "${SCRIPT_DIR}/collectors.conf")

status_init "${BASE_COLLECTION_PATH:-/must-gather}" "$(version)" || :
BASE_COLLECTION_PATH=$_STATUS_ROOT

for unit in \
    inspect_named_resources inspect_group_resources inspect_all_namespaces \
    "${collectors[@]}" \
    gather_aro
do
    status_register "$unit"
done

_gather_sync() {
    if [[ $_STATUS_INTERRUPTED == true ]]; then
        timeout 5s sync
    else
        sync
    fi
}

gather_finalize() {
    local exit_code=$1
    trap - EXIT
    _STATUS_FINISHING=true

    if ((exit_code != 0)) && [[ $_STATUS_INTERRUPTED == false ]]; then
        _status_failure
    fi

    status_finalize || exit_code=1
    _gather_sync || { _status_failure; exit_code=1; }
    if ((exit_code != 0)); then status_finalize || :; fi
    if ((_STATUS_SIGNAL_EXIT != 0)); then exit_code=$_STATUS_SIGNAL_EXIT; fi
    exit "$exit_code"
}

trap 'gather_finalize "$?"' EXIT
trap 'status_interrupt 143' TERM
trap 'status_interrupt 130' INT

{
    echo "openshift/must-gather"
    version
} >"${BASE_COLLECTION_PATH}/version" || _status_failure
get_log_collection_args

# Named resource list, eg. ns/openshift-config
named_resources=()

# Resource groups list, eg. pods
group_resources=()

# Resources to gather with `--all-namespaces` option
all_ns_resources=()

# Cluster Version Information
named_resources+=(ns/openshift-cluster-version)
group_resources+=(clusterversion)

# Operator and APIService Resources
group_resources+=(clusteroperators apiservices)

# Certificate Resources
group_resources+=(certificatesigningrequests)

# Machine/Node Resources
group_resources+=(nodes)

# Namespaces/Project Resources
named_resources+=(ns/default ns/openshift ns/kube-system ns/openshift-etcd)

# Storage Resources
group_resources+=(storageclasses persistentvolumes volumeattachments csidrivers csinodes volumesnapshotclasses volumesnapshotcontents volumegroupsnapshotclasses volumegroupsnapshotcontents clustercsidrivers volumeattributesclasses)
all_ns_resources+=(csistoragecapacities)

# Image-source Resources
group_resources+=(imagecontentsourcepolicies.operator.openshift.io imagedigestmirrorsets.config.openshift.io imagetagmirrorsets.config.openshift.io)

# OS Image Stream Resources
group_resources+=(osimagestreams.machineconfiguration.openshift.io)

# Internal Release Image Resources
group_resources+=(internalreleaseimages.machineconfiguration.openshift.io)

# Networking Resources
group_resources+=(networks.operator.openshift.io)

# Two Node Fencing (Pacemaker) Resources
group_resources+=(pacemakerclusters.etcd.openshift.io)

# Assisted Installer
named_resources+=(ns/assisted-installer)

# Leases
all_ns_resources+=(leases)

# Flowcontrol - API Priority and Fairness (APF)
group_resources+=(prioritylevelconfigurations.flowcontrol.apiserver.k8s.io flowschemas.flowcontrol.apiserver.k8s.io)

# ClusterResourceQuota
group_resources+=(clusterresourcequotas.quota.openshift.io)

# shellcheck disable=SC2086
status_start inspect_named_resources oc adm inspect ${log_collection_args} \
    --dest-dir "${BASE_COLLECTION_PATH}" ${rotated_pod_logs_arg} "${named_resources[@]}"

filtered_group_resources=()
for gr in "${group_resources[@]}"; do
	oc get "$gr" >/dev/null 2>&1
	# shellcheck disable=SC2181
	if [[ "$?" -eq 0 ]]; then
		filtered_group_resources+=("$gr")
	fi
done
group_resources_text=$(
	IFS=,
	echo "${filtered_group_resources[*]}"
)
# shellcheck disable=SC2086
status_start inspect_group_resources oc adm inspect ${log_collection_args} \
    --dest-dir "${BASE_COLLECTION_PATH}" ${rotated_pod_logs_arg} "${group_resources_text}"

all_ns_resources_text=$(
	IFS=,
	echo "${all_ns_resources[*]}"
)
# shellcheck disable=SC2086
status_start inspect_all_namespaces oc adm inspect ${log_collection_args} \
    --dest-dir "${BASE_COLLECTION_PATH}" ${rotated_pod_logs_arg} "${all_ns_resources_text}" --all-namespaces

for collector in "${collectors[@]}"; do
    case "$collector" in
        gather_service_logs) status_start "$collector" "${SCRIPT_DIR}/$collector" master ;;
        gather_ppc) MUST_GATHER_NODES_INSPECTED=true status_start "$collector" "${SCRIPT_DIR}/$collector" ;;
        *) status_start "$collector" "${SCRIPT_DIR}/$collector" ;;
    esac
done

echo "Waiting on subprocesses to finish execution."
status_wait_all

status_run gather_aro "${SCRIPT_DIR}/gather_aro"

if [ "${compress_after_gather}" = "true" ]; then
    compress_logs
fi

exit 0
